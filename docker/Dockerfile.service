# syntax=docker/dockerfile:1

# Backend image. Dependencies come exclusively from uv.lock (`--locked` fails
# the build if pyproject.toml and uv.lock disagree).
#
#   dev     - every dependency group, hot reload; used by compose.yaml
#   runtime - service group only, no dev tooling; for deployment

FROM python:3.12-slim-bookworm AS base

COPY --from=ghcr.io/astral-sh/uv:0.12.15 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app


FROM base AS dev

# Install dependencies first so this layer caches independently of source changes.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --locked --no-install-project

COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked

# Commands run through the venv directly; never re-sync at runtime.
ENV UV_NO_SYNC=1

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn mtlj.service.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir src"]


FROM base AS runtime

RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --locked --no-install-project --no-default-groups --group service

COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group service --no-editable

EXPOSE 8000

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn mtlj.service.main:app --host 0.0.0.0 --port 8000"]
