# syntax=docker/dockerfile:1

# Frontend dev image. Dependencies come exclusively from package-lock.json.
FROM node:26-bookworm-slim

WORKDIR /app

ENV NUXT_TELEMETRY_DISABLED=1

# Install dependencies first so this layer caches independently of source changes.
# The stamp lets the container detect a stale node_modules volume on startup.
COPY fe/package.json fe/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts && cp package-lock.json node_modules/.lock-stamp

COPY fe/ .

EXPOSE 3000

# node_modules is a named volume, so it outlives image rebuilds. Reinstall
# only when package-lock.json has changed since it was populated.
CMD ["sh", "-c", "cmp -s package-lock.json node_modules/.lock-stamp || { npm ci && cp package-lock.json node_modules/.lock-stamp; }; exec npm run dev -- --host 0.0.0.0"]
