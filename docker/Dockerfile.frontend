# syntax=docker/dockerfile:1

# Frontend dev image: Node 22 + dependencies from package-lock.json.
# The code itself isn't copied in; compose.yaml mounts frontend/ at /app.
FROM node:22-bookworm-slim

ENV NUXT_TELEMETRY_DISABLED=1
WORKDIR /app

# Cached until package-lock.json changes.
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts && cp package-lock.json node_modules/.lock-stamp

COPY docker/start-frontend.sh /usr/local/bin/start-frontend.sh

EXPOSE 3000
CMD ["sh", "/usr/local/bin/start-frontend.sh"]
