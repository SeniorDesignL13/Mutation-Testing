# Store and check out every text file with LF endings, on every OS.
# Files are shared with Linux containers, so CRLF would only cause trouble.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary

# Lockfiles are generated: collapse them in GitHub diffs.
uv.lock linguist-generated=true
fe/package-lock.json linguist-generated=true
