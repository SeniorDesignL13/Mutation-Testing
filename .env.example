# Optional. Only needed if you want to change a default or add an API key:
#   cp .env.example .env
# Never commit .env (git ignores it).

# --- API keys for LLM judges (DeepEval, Ragas) ---
# OPENAI_API_KEY=sk-...

# --- Ports on your machine (change one if "port is already allocated") ---
API_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# --- Database login ---
POSTGRES_USER=mtlj
POSTGRES_PASSWORD=mtlj
POSTGRES_DB=mtlj

# --- Used when you run Python on your machine (uv run ...). ---
# Docker sets its own value, so this line doesn't affect `docker compose up`.
# If you changed POSTGRES_PORT above, change 5432 here to match.
DATABASE_URL=postgresql+asyncpg://mtlj:mtlj@localhost:5432/mtlj
