# Optional. Copy to .env to override defaults: `cp .env.example .env`.
# `docker compose up` works without this file.

# --- Postgres ---
POSTGRES_USER=mtlj
POSTGRES_PASSWORD=mtlj
POSTGRES_DB=mtlj

# --- Host ports (change if something else on your machine already uses them) ---
POSTGRES_PORT=5432
API_PORT=8000
FE_PORT=3000

# --- Backend service ---
# Used for native (non-Docker) dev. Inside Docker, compose.yaml points this at the db container.
DATABASE_URL=postgresql+asyncpg://mtlj:mtlj@localhost:5432/mtlj
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
NUXT_PUBLIC_API_BASE=http://localhost:8000

# --- Diagnostics (/testing routes) ---
ENABLE_TESTING_ROUTES=true
EXTERNAL_CHECK_URL=https://api.github.com

# --- Local model serving (only used with `--profile models`) ---
OLLAMA_HOST=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001/v1
